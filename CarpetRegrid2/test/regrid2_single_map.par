# Test radius-driven regridding and the relative-change threshold in single-map mode.
# Coordinates and last_iteration record the resulting grid and regrid decisions.
ActiveThorns = "CoordBase CartGrid3D SymBase InitBase IOUtil Carpet CarpetIOASCII CarpetLib LoopControl Boundary Time Trigger"

Cactus::cctk_itlast = 12
Cactus::cctk_initial_time = 0
Time::dtfac = 0.25

CartGrid3D::type = "coordbase"
CartGrid3D::avoid_origin = "no"
CoordBase::domainsize = "minmax"
CoordBase::spacing = "gridspacing"
CoordBase::xmin = -24
CoordBase::xmax = 24
CoordBase::ymin = -24
CoordBase::ymax = 24
CoordBase::zmin = 0
CoordBase::zmax = 24
CoordBase::dx = 2
CoordBase::dy = 2
CoordBase::dz = 2

CoordBase::boundary_size_x_lower = 3
CoordBase::boundary_size_x_upper = 3
CoordBase::boundary_size_y_lower = 3
CoordBase::boundary_size_y_upper = 3
CoordBase::boundary_size_z_lower = 3
CoordBase::boundary_size_z_upper = 3

CoordBase::boundary_shiftout_x_lower = 1
CoordBase::boundary_shiftout_x_upper = 1
CoordBase::boundary_shiftout_y_lower = 1
CoordBase::boundary_shiftout_y_upper = 1
CoordBase::boundary_shiftout_z_lower = 1
CoordBase::boundary_shiftout_z_upper = 1

ActiveThorns = "CarpetRegrid2"
Carpet::max_refinement_levels = 3
Carpet::regrid_in_level_mode = yes
CarpetRegrid2::regrid_every = 1
CarpetRegrid2::num_centres = 2
CarpetRegrid2::num_levels_1 = 3
CarpetRegrid2::num_levels_2 = 2

CarpetRegrid2::radius_1[1] = 5
CarpetRegrid2::radius_1[2] = 2.5
CarpetRegrid2::radius_rel_change_threshold_1 = 0.3
CarpetRegrid2::position_x_1 = 4
CarpetRegrid2::position_y_1 = 4

CarpetRegrid2::radius_2[1] = 5
CarpetRegrid2::position_x_2 = -10
CarpetRegrid2::position_y_2 = -10

Carpet::domain_from_coordbase = yes
Carpet::ghost_size_x = 3
Carpet::ghost_size_y = 3
Carpet::ghost_size_z = 3
Carpet::adaptive_stepsize = no
Carpet::init_fill_timelevels = yes

IO::out_dir = $parfile
IO::out_group_separator = "-"
IO::out_fileinfo = none
IO::parfile_write = no

IOASCII::out2D_every = 1
IOASCII::out2D_xyplane_z = 0
IOASCII::out2D_xzplane_y = 10
IOASCII::out2D_yzplane_x = 10
IOASCII::one_file_per_group = yes
IOASCII::out2D_vars = "Grid::coordinates"
IOASCII::output_ghost_points = no
IOASCII::compact_format = yes

# Initialize radius history in level mode, then switch to single-map mode.
Trigger::Trigger_Number = 3
Trigger::Trigger_Checked_Variable[0] = "Trigger::trigger_cctk_iteration"
Trigger::Trigger_Relation[0] = ">"
Trigger::Trigger_Checked_Value[0] = 1
Trigger::Trigger_Reaction[0] = "steerparam"
Trigger::Trigger_Steered_Parameter_Thorn[0] = "Carpet"
Trigger::Trigger_Steered_Parameter_Name[0] = "regrid_in_level_mode"
Trigger::Trigger_Steered_Parameter_Value[0] = "no"
Trigger::Trigger_Once[0] = 1

# Change centre 1's level 2 radius from 2.5 to 4, triggering a regrid.
Trigger::Trigger_Checked_Variable[1] = "Trigger::trigger_cctk_iteration"
Trigger::Trigger_Relation[1] = ">"
Trigger::Trigger_Checked_Value[1] = 3
Trigger::Trigger_Reaction[1] = "steerscalar"
Trigger::Trigger_Steered_Scalar[1] = "CarpetRegrid2::radius[0]"
Trigger::Trigger_Steered_Scalar_Index[1] = 2
Trigger::Trigger_Steered_Scalar_Value[1] = "4"
Trigger::Trigger_Once[1] = 1

# The change from 4 to 3.5 is below the threshold and must not trigger a regrid.
Trigger::Trigger_Checked_Variable[2] = "Trigger::trigger_cctk_iteration"
Trigger::Trigger_Relation[2] = ">"
Trigger::Trigger_Checked_Value[2] = 7
Trigger::Trigger_Reaction[2] = "steerscalar"
Trigger::Trigger_Steered_Scalar[2] = "CarpetRegrid2::radius[0]"
Trigger::Trigger_Steered_Scalar_Index[2] = 2
Trigger::Trigger_Steered_Scalar_Value[2] = "3.5"
Trigger::Trigger_Once[2] = 1

IOASCII::out0D_every = 1
IOASCII::out0D_vars = "CarpetRegrid2::last_iteration"
